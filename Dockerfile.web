FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/ ./lib/
COPY artifacts/social-playout/package.json ./artifacts/social-playout/

RUN npm install -g pnpm && pnpm install --frozen-lockfile

COPY artifacts/social-playout/ ./artifacts/social-playout/
COPY tsconfig.base.json tsconfig.json ./

ENV BASE_PATH=/
RUN pnpm --filter @workspace/social-playout run build

FROM nginx:alpine
COPY --from=builder /app/artifacts/social-playout/dist/public /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
